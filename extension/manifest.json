{
  "manifest_version": 3,
  "name": "RouterDeck Connect",
  "version": "0.2.0",
  "description": "Lets the RouterDeck website manage the router on your home network. Private addresses only, with per-site approval.",
  "minimum_chrome_version": "110",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://router.pramitha.lk/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": { "default_title": "RouterDeck Connect", "default_popup": "popup.html" }
}
