{
  "manifest_version": 3,
  "name": "RouterDeck",
  "version": "1.0.0",
  "description": "Manage the router in your home from router.pramitha.lk: devices, Wi-Fi and settings. Home network only.",
  "minimum_chrome_version": "110",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://router.pramitha.lk/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "RouterDeck",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "homepage_url": "https://router.pramitha.lk",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "short_name": "RouterDeck"
}
